{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-sdlc-demo/schemas/claim-assessment.schema.json",
  "title": "Synthetic claim assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentId",
    "claimId",
    "generatedAt",
    "summary",
    "completenessFindings",
    "conflicts",
    "policyBasis",
    "policyCitations",
    "recommendedActions",
    "triageRecommendation",
    "humanReviewRequired"
  ],
  "properties": {
    "assessmentId": {
      "type": "string",
      "pattern": "^asm-[a-z0-9-]+$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^clm-[a-z0-9-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Do not state policy conclusions unless supported by citations in policyCitations."
    },
    "completenessFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingCode", "status", "description"],
        "properties": {
          "findingCode": {
            "type": "string",
            "enum": [
              "required_information_missing",
              "required_document_missing",
              "policy_inactive_on_loss_date",
              "driver_not_listed",
              "section_4_late_reporting",
              "section_4_reporting_dates_inconsistent",
              "section_4_missing_police_report",
              "repair_estimate_above_review_threshold",
              "possible_duplicate_artifact",
              "possible_prior_damage",
              "straight_through_candidate",
              "human_escalation",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["clear", "missing", "inconsistent", "needs_review", "unknown"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "relatedArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^art-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "sourceArtifactIds"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sourceArtifactIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^art-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "policyBasis": {
      "type": "string",
      "enum": ["grounded", "unavailable", "not_assessed"],
      "description": "A grounded assessment must include at least one supporting policy citation; unavailable or unassessed policy content must not be presented as a policy conclusion."
    },
    "policyCitations": {
      "type": "array",
      "items": {
        "$ref": "policy-citation.schema.json"
      },
      "description": "Citations supporting policy-grounded statements. An unavailable citation must be reported as a limitation, not invented."
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "$ref": "recommended-action.schema.json"
      }
    },
    "triageRecommendation": {
      "type": "string",
      "enum": [
        "request_information",
        "human_review",
        "escalate",
        "straight_through_candidate"
      ]
    },
    "humanReviewRequired": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policyBasis": {
            "const": "grounded"
          }
        },
        "required": ["policyBasis"]
      },
      "then": {
        "properties": {
          "policyCitations": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "policyCitations": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
